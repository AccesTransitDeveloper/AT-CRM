# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform Javascript API in Employee Live Map
GOOGLE_MAPS_PLATFORM_KEY=

# TWILIO VOICE API: Automated passenger arrival notification calls & DTMF IVR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# TELEGRAM BOT API: Instant dispatch alerts for MTA trip cancellations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROXIMITY_RADIUS_MILES=0.3

# CLONE APP ADMIN PANEL REST API INTEGRATION LAYER
CLONE_API_BASE_URL="https://api.clone-admin.accessibletransit.com"
CLONE_API_AUTH_MODE="jwt" # "jwt" or "oauth2_client_credentials"
CLONE_API_CLIENT_ID="at_service_account_crm_prod"
CLONE_API_CLIENT_SECRET=
CLONE_API_USERNAME=
CLONE_API_PASSWORD=
CLONE_SYNC_POLL_INTERVAL_MS=20000 # Live orders polling frequency (15000-30000 ms)
CLONE_SYNC_PROFILE_INTERVAL_MS=600000 # Background driver profile sync frequency (10-15 mins)
